---
// JYC-CAP-02: one tag's articles. Built by the composition rule (BRAND-004 §4): the page
// intro and the library's article rows. Tag pages exist only for tags in use.
import Base from '../../../../layouts/Base.astro';
import ArticleList from '../../../../components/ArticleList.astro';
import { publishedArticles, withTag, allTags } from '../../../../lib/articles';

export async function getStaticPaths() {
  const all = await publishedArticles();
  return allTags(all).map((t) => ({ params: { tag: t.slug }, props: { name: t.name, articles: withTag(all, t.name) } }));
}
const { name, articles } = Astro.props;
---
<Base title={`Tagged ${name}`} description={`Articles tagged ${name}.`} bleed>
  <div class="page-intro container">
    <p class="eyebrow">Tag</p>
    <h1>{name}</h1>
    <p class="lead">{articles.length === 1 ? '1 article' : `${articles.length} articles`}</p>
  </div>
  <div class="container listing">
    <ArticleList articles={articles} />
    <p><a class="text-link" href="/writing/"><span aria-hidden="true">←</span>&nbsp;All writing</a></p>
  </div>
</Base>

<style>
  .listing { display: grid; gap: var(--space-block); padding-bottom: var(--space-section); }
</style>
