---
// JYC-CAP-06: one consulting track on the Work with me page (handoff §7). Both tracks use
// this one component, so they share one structure: the problem, the outcomes, what working
// together looks like, and the next step, which reaches the contact panel on the same page.
// It never shows Justin's fees or service pricing.
interface Props { id: 'enterprise' | 'construction'; eyebrow: string; title: string; problem: string; services: string[] }
const { id, eyebrow, title, problem, services } = Astro.props;
---
<article class="track card card-lg card-accent" id={id} aria-labelledby={`${id}-title`} data-track={id}>
  <header>
    <p class="label">{eyebrow}</p>
    <h2 id={`${id}-title`}>{title}</h2>
  </header>

  <div data-slot="problem">
    <h3 class="visually-hidden">The problem</h3>
    <p class="track-problem">{problem}</p>
  </div>

  <div data-slot="outcomes">
    <h3 class="label-muted">What an engagement delivers</h3>
    <ul class="check-list"><li>[COPY]</li></ul>
  </div>

  <div class="panel" data-slot="engagements">
    <h3 class="label-muted">What working together looks like</h3>
    <ul class="dash-list">{services.map((s) => <li>{s}</li>)}</ul>
    <slot name="details" />
  </div>

  <div class="track-cta" data-slot="next-step">
    <h3 class="visually-hidden">Next step</h3>
    <a class="btn btn-primary" href="#contact">Start a conversation <span aria-hidden="true">→</span></a>
    <p class="track-note">[COPY]</p>
  </div>
</article>

<style>
  .track {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    gap: 1.5rem;
    align-content: start;
  }
  .track h2 { font-size: var(--fs-section); font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; margin-top: 0.5rem; }
  .track h3.label-muted { margin-bottom: 0.85rem; }
  .track-problem { font-size: var(--fs-body-lg); line-height: 1.65; }
  .track .panel :global(p) { margin-top: 1rem; font-size: var(--fs-ui); color: var(--ink); }
  .track-cta { display: flex; flex-direction: column; gap: 1rem; align-self: end; }
  .track-cta .btn { align-self: flex-start; }
  .track-note { font-size: var(--fs-small); color: var(--muted); line-height: 1.6; }
  @media (max-width: 768px) {
    .track-cta .btn { align-self: stretch; }
  }
</style>
