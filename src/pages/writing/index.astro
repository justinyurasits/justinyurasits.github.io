---
// JYC-CAP-02: the writing library (handoff §7, Writing). The featured article leads, with
// the fallback for one set back to draft; then "All writing" with category filters
// (without JavaScript every article shows); then the category and tag pages. Every listing
// is built from published content.
//
// Recent shows only when it would show an article the rest of the page doesn't (Justin,
// 2026-11-23). "All writing" lists every article today, so Recent stays hidden until
// that listing stops showing them all.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publishedArticles, featuredArticle, recent, categories, allTags } from '../../lib/articles';
import { articleUrl, formatDate, tagUrl } from '../../lib/format';

const all = await publishedArticles();
const lead = await featuredArticle(all);
const tags = allTags(all);
const listed = all; // what "All writing" shows
const shownElsewhere = new Set([lead?.id, ...listed.map((a) => a.id)]);
const recentArticles = recent(all);
const showRecent = recentArticles.some((a) => !shownElsewhere.has(a.id));
const counts = categories.map((c) => ({ ...c, count: all.filter((a) => a.data.category === c.name).length }));
---
<Base title="Writing" description="[COPY]" bleed>
  <div class="page-intro container">
    <p class="eyebrow">Ideas and perspectives</p>
    <h1>Writing</h1>
    <p class="lead">[COPY]</p>
  </div>

  <div class="container wl">
    {all.length === 0 ? <p>No articles yet.</p> : (
      <>
        {lead && (
          <section aria-labelledby="featured" data-section="featured">
            <h2 id="featured" class="visually-hidden">Featured</h2>
            <a class:list={['card card-lg wl-feature', { 'has-cover': lead.data.cover }]} href={articleUrl(lead.id)} data-article={lead.id}>
              <span class="wl-feature-text">
                <span class="label-muted">Featured · {lead.data.category}</span>
                <span class="wl-feature-title">{lead.data.title}</span>
                <span class="wl-feature-desc">{lead.data.deck ?? lead.data.description}</span>
                <span class="wl-feature-meta"><time datetime={lead.data.date.toISOString().slice(0, 10)}>{formatDate(lead.data.date)}</time></span>
                <span class="text-link wl-feature-link">Read the article&nbsp;<span aria-hidden="true">→</span></span>
              </span>
              {lead.data.cover && (
                <span class="wl-cover"><Image src={lead.data.cover.src} alt={lead.data.cover.alt} widths={[640, 960, 1280]} sizes="(max-width: 1024px) 100vw, 560px" loading="eager" /></span>
              )}
            </a>
          </section>
        )}

        {showRecent && (
          <section aria-labelledby="recent" data-section="recent">
            <h2 id="recent" class="wl-title">Recent</h2>
            <ArticleList articles={recentArticles} />
          </section>
        )}

        <section aria-labelledby="all" data-section="all">
          <div class="wl-all-header">
            <h2 id="all" class="wl-title">All writing</h2>
            <div class="filter-row" role="group" aria-label="Filter by category" data-filter-group="writing" hidden>
              <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
              {counts.filter((c) => c.count > 0).map((c) => <button type="button" class="chip" data-filter={c.slug} aria-pressed="false">{c.name}</button>)}
              <p class="wl-count" aria-live="polite" data-filter-status>Showing {all.length} of {all.length}</p>
            </div>
          </div>
          <ArticleList articles={listed} filter="writing" />
        </section>

        <nav class="panel wl-browse" aria-label="Browse by category and tag">
          <div>
            <h2 class="label-muted">Categories</h2>
            <ul>{counts.map((c) => <li><a class="text-link" href={`/writing/category/${c.slug}/`}>{c.name}</a></li>)}</ul>
          </div>
          {tags.length > 0 && (
            <div>
              <h2 class="label-muted">Tags</h2>
              <ul class="wl-tags">{tags.map((t) => <li><a class="chip" href={tagUrl(t.name)}>{t.name}</a></li>)}</ul>
            </div>
          )}
        </nav>
      </>
    )}
  </div>
</Base>

<style>
  .wl { display: grid; gap: var(--space-block); padding-bottom: var(--space-section); }
  .wl-title { font-size: var(--fs-section); font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; color: var(--ink); margin-bottom: 1rem; }

  .wl-feature { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; color: inherit; text-decoration: none; transition: border-color var(--ease), box-shadow var(--ease); }
  .wl-feature:hover { border-color: var(--line-strong); }
  .wl-feature.has-cover { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .wl-feature-text { display: flex; flex-direction: column; gap: 1rem; }
  .wl-feature-title { font-size: var(--fs-section-title); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink); }
  .wl-feature-desc { font-family: var(--font-serif); font-style: italic; font-size: var(--fs-lead); line-height: 1.6; color: var(--body); max-width: 60ch; }
  .wl-feature-meta { font-size: var(--fs-small); color: var(--muted); }
  .wl-feature-link { align-self: flex-start; }
  .wl-feature:hover .wl-feature-title { color: var(--accent-strong); }
  .wl-cover { display: block; aspect-ratio: 16 / 10; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); }
  .wl-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .wl-all-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: 1rem; }
  .wl-all-header .wl-title { margin-bottom: 0; }
  .wl-count { flex-basis: 100%; font-size: var(--fs-small); color: var(--muted); }

  .wl-browse { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem; }
  .wl-browse h2 { margin-bottom: 0.5rem; }
  .wl-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .wl-tags .chip { text-decoration: none; }

  @media (max-width: 1024px) {
    .wl-feature.has-cover { grid-template-columns: 1fr; }
    .wl-cover { order: -1; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 768px) {
    .wl-browse { grid-template-columns: 1fr; }
  }
</style>
