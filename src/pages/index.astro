---
// JYC-CAP-01: the homepage (handoff §7, Home), in the spec's order: hero → capabilities →
// Solutions → Demos → Writing → Work with me. The hero's headline and both actions show
// without scrolling at 375px and 1280px. Writing covers both categories whenever both have
// a published article. Copy is the spec's working text or [COPY] until the copy pass (#27).
import { Image, Picture } from 'astro:assets';
import headshot from '../assets/images/headshot.jpg';
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
import { homepageWriting } from '../lib/home';
import { publishedArticles } from '../lib/articles';
import { getPublished } from '../lib/content';
import { splitFeatured } from '../lib/demos';

// Writing: the featured lead, one article per category, then the newest, three in all.
const { lead, curated } = await homepageWriting();
const published = await publishedArticles();
const rows = [...new Map([lead, ...curated, ...published].filter((a) => !!a).map((a) => [a!.id, a!])).values()].slice(0, 3);

// Demos: the featured build's first screenshot, when it has one.
const { featured: build } = splitFeatured(await getPublished('projects'));
const buildShot = build?.data.screenshots[0];

const capabilities = [
  { title: 'AI Product Leadership', text: '[COPY]' },
  { title: 'AI Systems', text: '[COPY]' },
  { title: 'Construction AI', text: '[COPY]' },
];
---
<Base title="Justin Yurasits" description="[COPY]" bleed>
  <section class="hero" aria-labelledby="intro" data-section="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">AI product leadership</p>
        <h1 id="intro" class="hero-headline">AI Product Leader. Systems Designer. <em>Hands-On Builder.</em></h1>
        <p class="hero-body" data-slot="supporting">I combine enterprise AI product leadership, firsthand business operations experience, and hands-on AI software development to help organizations turn complex problems into practical AI systems.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/work-with-me/" data-action="work-with-me">Work with me <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/solutions/" data-action="explore">Explore my work</a>
        </div>
      </div>
      <div class="hero-portrait">
        <Picture src={headshot} alt="Justin Yurasits" formats={['avif', 'webp']} widths={[480, 720, 960, 1280]} sizes="(max-width: 768px) 100vw, 54vw" loading="eager" fetchpriority="high" data-portrait />
      </div>
    </div>
  </section>

  <section class="caps" aria-label="What I do" data-section="capabilities">
    <div class="container">
      <ul class="caps-list">
        {capabilities.map((c) => <li><strong>{c.title}</strong><span>{c.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="feature" aria-labelledby="solutions-title" data-section="solutions">
    <div class="container feature-inner">
      <div class="feature-media">
        <PlaceholderMedia label="Construction OS" needs="a verified Construction OS image (16:10)" ratio="16 / 10" />
      </div>
      <div class="feature-text">
        <h2 id="solutions-title" class="section-title">Solutions</h2>
        <p class="lead">[COPY]</p>
        <div class="feature-links">
          <a class="text-link" href="/solutions/">Explore solutions&nbsp;<span aria-hidden="true">→</span></a>
          <a class="text-link" href="/solutions/construction-os/">Construction OS&nbsp;<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="feature feature-reverse" aria-labelledby="demos-title" data-section="demos">
    <div class="container feature-inner">
      <div class="feature-media">
        {buildShot ? (
          <figure class="feature-shot"><Image src={buildShot.src} alt={buildShot.alt} widths={[640, 960, 1280]} sizes="(max-width: 768px) 100vw, 640px" /></figure>
        ) : (
          <PlaceholderMedia label="A working demo" needs="a real demo still, or keep as an illustration (16:10)" ratio="16 / 10" />
        )}
      </div>
      <div class="feature-text">
        <h2 id="demos-title" class="section-title">Demos</h2>
        <p class="lead">[COPY]</p>
        <div class="feature-links">
          <a class="text-link" href="/demos/">See demos and builds&nbsp;<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-writing" aria-labelledby="writing-title" data-section="writing">
    <div class="container home-writing-inner">
      <div class="home-writing-intro">
        <h2 id="writing-title" class="section-title">Writing</h2>
        <p class="lead">[COPY]</p>
        <a class="text-link" href="/writing/">All writing&nbsp;<span aria-hidden="true">→</span></a>
      </div>
      <div data-lead={lead?.id}>
        <ArticleList articles={rows} empty="No articles yet." />
      </div>
    </div>
  </section>

  <section class="home-wm" aria-labelledby="wm-title" data-section="work-with-me">
    <div class="container">
      <div class="panel panel-lg home-wm-panel">
        <h2 id="wm-title" class="section-title">Work with me</h2>
        <p class="lead">[COPY]</p>
        <div class="home-wm-tracks">
          <div>
            <h3>Enterprise AI Consulting &amp; Leadership</h3>
            <p>[COPY]</p>
            <a class="btn btn-primary" href="/work-with-me/#enterprise">Enterprise AI <span aria-hidden="true">→</span></a>
          </div>
          <div>
            <h3>Construction AI Consulting</h3>
            <p>[COPY]</p>
            <a class="btn btn-primary" href="/work-with-me/#construction">Construction AI <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-title { font-size: var(--fs-section-title); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink); margin-bottom: 1rem; }

  /* Hero: text 11fr, a 7:5 portrait 13fr with a diagonal left edge. */
  .hero { padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(2.5rem, 6vw, 5rem); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 13fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .hero-text .eyebrow { margin-bottom: 1.25rem; }
  .hero-headline { font-size: var(--fs-hero); font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; color: var(--ink); }
  .hero-headline em { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: var(--fs-hero-em); letter-spacing: -0.01em; }
  .hero-body { margin-top: 1.25rem; font-size: var(--fs-lead); line-height: 1.6; color: var(--body); max-width: 36rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 1.75rem; }
  .hero-portrait :global(img) {
    display: block; width: 100%; height: auto; aspect-ratio: 7 / 5; object-fit: cover; object-position: 50% 42%;
    border-radius: var(--radius-lg); clip-path: polygon(16% 0, 100% 0, 100% 100%, 0 100%);
  }

  /* Capabilities band: three items between hairlines. */
  .caps { border-block: 1px solid var(--line); }
  .caps-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .caps-list li { display: grid; gap: 0.25rem; padding: 1.5rem clamp(1rem, 3vw, 2rem); }
  .caps-list li + li { border-left: 1px solid var(--line); }
  .caps-list li:first-child { padding-left: 0; }
  .caps-list strong { font-size: var(--fs-body); color: var(--ink); }
  .caps-list span { font-size: var(--fs-small); color: var(--muted); }

  /* Features: image 7fr, text 5fr; Demos mirrored. */
  .feature { padding-top: var(--space-section); }
  .feature-inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .feature-reverse .feature-inner { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .feature-reverse .feature-media { order: 2; }
  .feature-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-top: 1.25rem; }
  .feature-shot { margin: 0; aspect-ratio: 16 / 10; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); }
  .feature-shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

  /* Writing: intro left, article rows right. */
  .home-writing { padding-top: var(--space-section); }
  .home-writing-inner { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(2rem, 5vw, 4.5rem); }
  .home-writing-intro .lead { margin-bottom: 1rem; }

  /* Work with me: a panel with both tracks. */
  .home-wm { padding: var(--space-section) 0; }
  .home-wm-panel { display: grid; gap: 0.5rem; }
  .home-wm-tracks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem clamp(2rem, 4vw, 3.5rem); margin-top: 1.5rem; }
  .home-wm-tracks > div { display: grid; gap: 0.75rem; justify-items: start; align-content: start; border-top: 1px solid var(--line-strong); padding-top: 1.25rem; }
  .home-wm-tracks h3 { font-size: var(--fs-card-title); font-weight: 700; color: var(--ink); }
  .home-wm-tracks p { color: var(--body); }

  @media (max-width: 768px) {
    .hero-inner, .feature-inner, .feature-reverse .feature-inner, .home-writing-inner, .home-wm-tracks { grid-template-columns: 1fr; }
    .feature-media, .feature-reverse .feature-media { order: 2; }
    .caps-list { grid-template-columns: 1fr; }
    .caps-list li { padding: 1rem 0; }
    .caps-list li + li { border-left: 0; border-top: 1px solid var(--line); }
    .home-wm-tracks .btn { width: 100%; justify-self: stretch; }
  }
</style>
