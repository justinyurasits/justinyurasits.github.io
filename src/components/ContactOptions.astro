---
// The contact options (JYC-CAP-08): one email link per reason, the booking link, and
// LinkedIn alongside them. Used in the Work with me contact panel.
import { REASONS, BOOKING_URL, EMAIL, LINKEDIN_URL, mailto, type ReasonId } from '../lib/contact';
interface Props { reasons?: readonly ReasonId[]; headingLevel?: 2 | 3 }
const { reasons, headingLevel = 2 } = Astro.props;
const shown = reasons ? REASONS.filter((r) => reasons.includes(r.id)) : REASONS;
const H = `h${headingLevel}`;
---
<div class="contact-options" data-contact-options>
  <H>Email</H>
  <ul>
    {shown.map((r) => <li><a href={mailto(r.subject)} data-reason={r.id}>{r.label}</a></li>)}
  </ul>
  <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  <H>Book a call</H>
  <p><a href={BOOKING_URL} data-booking>{BOOKING_URL.replace('https://', '')}</a></p>
  <H>LinkedIn</H>
  <p><a href={LINKEDIN_URL} data-linkedin>Connect on LinkedIn</a></p>
</div>
