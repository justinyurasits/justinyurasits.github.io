---
// Site navigation (JYC-CAP-08): Solutions, Demos, Writing, Training and About, with Work
// with me as the header's action on every page.
export const NAV = [
  { href: '/solutions/', label: 'Solutions' },
  { href: '/demos/', label: 'Demos' },
  { href: '/writing/', label: 'Writing' },
  { href: '/training/', label: 'Training' },
  { href: '/about/', label: 'About' },
];
export const ACTION = { href: '/work-with-me/', label: 'Work with me' };
const current = Astro.url.pathname;
---
<nav aria-label="Main">
  <ul>
    {NAV.map((item) => (
      <li>
        <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>
<a class="nav-action" href={ACTION.href} data-action aria-current={current.startsWith(ACTION.href) ? 'page' : undefined}>{ACTION.label}</a>
