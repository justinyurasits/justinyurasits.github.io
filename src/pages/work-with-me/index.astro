---
// JYC-CAP-06 and JYC-CAP-08: one page with two consulting tracks of equal weight, and the
// contact panel they both end in (handoff §7, Work with me).
import Base from '../../layouts/Base.astro';
import Track from '../../components/Track.astro';
import { REASONS, BOOKING_URL, EMAIL, LINKEDIN_URL, RESUME_URL, mailto } from '../../lib/contact';

const enterprise = [
  'Contract or C2C',
  'Fractional AI product leadership',
  'Advisory',
  'Product strategy',
  'Solution design',
  'Modernization',
  'Implementation leadership',
];
const construction = [
  'Education',
  'Opportunity assessment',
  'Business workflow design',
  'Advisory',
  'Custom implementation',
  'Construction OS-related services',
];
---
<Base title="Work with me" description="[COPY]" bleed>
  <div class="page-intro container">
    <p class="eyebrow">Consulting</p>
    <h1>Work with me</h1>
    <p class="lead">[COPY]</p>
  </div>

  <div class="container wm">
    <section class="wm-tracks" aria-labelledby="tracks-title">
      <h2 id="tracks-title" class="visually-hidden">Consulting tracks</h2>
      <Track id="enterprise" eyebrow="Track one" title="Enterprise AI Consulting & Leadership" services={enterprise}>
        <Fragment slot="details">
          <p>Remote, based in Boston.</p>
          <p data-slot="resume"><a class="text-link" href={RESUME_URL} download data-resume>Download my résumé (PDF)&nbsp;<span aria-hidden="true">↓</span></a></p>
        </Fragment>
      </Track>
      <Track id="construction" eyebrow="Track two" title="Construction AI Consulting" services={construction} />
    </section>

    <section id="contact" class="wm-contact panel panel-lg" aria-labelledby="contact-title" data-contact-panel>
      <h2 id="contact-title">Start a conversation</h2>
      <p>[COPY]</p>
      <div class="wm-reasons">
        <h3 class="label-muted">Email me about</h3>
        <ul>
          {REASONS.map((r) => <li><a class="text-link" href={mailto(r.subject)} data-reason={r.id}>{r.label}</a></li>)}
        </ul>
        <p class="wm-address"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </div>
      <div class="wm-buttons">
        <a class="btn btn-primary" href={BOOKING_URL} data-booking>Book a call <span aria-hidden="true">→</span></a>
        <a class="btn btn-secondary" href={LINKEDIN_URL} data-linkedin>Connect on LinkedIn</a>
      </div>
    </section>

    <aside class="note" aria-label="A note on fit">
      <p>[COPY]</p>
    </aside>
  </div>
</Base>

<style>
  .wm { display: grid; gap: var(--space-block); padding-bottom: var(--space-section); }
  .wm-tracks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(1.5rem, 3vw, 2rem); }
  .wm-contact { text-align: center; display: grid; justify-items: center; gap: 1.25rem; padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .wm-contact h2 { font-size: var(--fs-section-title); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .wm-contact > p { max-width: 56ch; font-size: var(--fs-body-lg); line-height: 1.65; }
  .wm-reasons { display: grid; justify-items: center; gap: 0.25rem; }
  .wm-reasons ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1.5rem; }
  .wm-address a { font-size: var(--fs-ui); color: var(--body); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .wm-address a:hover { color: var(--ink); text-decoration-color: var(--accent); }
  .wm-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .note p { font-size: var(--fs-ui); line-height: 1.65; max-width: 72ch; }
  @media (max-width: 768px) {
    .wm-tracks { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .wm-tracks :global(.track) { grid-template-rows: none; grid-row: auto; }
    .wm-buttons { flex-direction: column; justify-self: stretch; }
    .wm-buttons .btn { width: 100%; }
  }
</style>
