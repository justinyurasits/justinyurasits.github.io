---
// Site navigation (JYC-CAP-08, handoff §5): Solutions, Demos, Writing, Training and About,
// with Work with me as the header's action on every page. The current page is marked
// "page"; inside a section (an article under Writing) the section is marked "true".
export const NAV = [
  { href: '/solutions/', label: 'Solutions' },
  { href: '/demos/', label: 'Demos' },
  { href: '/writing/', label: 'Writing' },
  { href: '/training/', label: 'Training' },
  { href: '/about/', label: 'About' },
];
export const ACTION = { href: '/work-with-me/', label: 'Work with me' };
export const currentFor = (href: string, path: string) =>
  path === href ? 'page' : path.startsWith(href) ? 'true' : undefined;
const path = Astro.url.pathname;
---
<nav class="site-nav" aria-label="Main">
  <ul>
    {NAV.map((item) => (
      <li><a href={item.href} aria-current={currentFor(item.href, path)}>{item.label}</a></li>
    ))}
  </ul>
</nav>
<a class="btn btn-primary btn-sm header-action" href={ACTION.href} data-action aria-current={currentFor(ACTION.href, path)}>{ACTION.label} <span aria-hidden="true">→</span></a>
<button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" hidden data-menu-button>
  <span></span><span></span><span></span>
</button>
<div class="mobile-menu" id="mobile-menu" hidden data-menu>
  <ul>
    {NAV.map((item) => (
      <li><a href={item.href} aria-current={currentFor(item.href, path)}>{item.label}</a></li>
    ))}
  </ul>
  <a class="btn btn-primary" href={ACTION.href}>{ACTION.label} <span aria-hidden="true">→</span></a>
</div>
