---
// JYC-CAP-07: About. Every credential, employer, figure and date comes from the facts
// register (Career Facts v5.7), and the facts check verifies each one. The approved
// design comes in M2.16 (#58).
import Base from '../../layouts/Base.astro';
import Experience from '../../components/Experience.astro';
import { facts } from '../../lib/facts';

const ids = Object.keys(facts.experience);
const enterprise = ids.filter((id) => facts.experience[id].sector === 'enterprise');
const construction = ids.filter((id) => facts.experience[id].sector === 'construction');
---
<Base title="About" description="[COPY]">
  <h1>About</h1>
  <p>[COPY]</p>
  <p data-fact="about.location">{facts.about.location}</p>

  <section aria-labelledby="enterprise">
    <h2 id="enterprise">Enterprise leadership</h2>
    {enterprise.map((id) => <Experience id={id} />)}
  </section>

  <section aria-labelledby="construction">
    <h2 id="construction">Construction</h2>
    {construction.map((id) => <Experience id={id} />)}
  </section>

  <section aria-labelledby="credentials">
    <h2 id="credentials">Credentials</h2>
    <ul>
      {Object.entries(facts.credentials).map(([k, v]) => <li data-fact={`credentials.${k}`}>{v}</li>)}
    </ul>
  </section>

  <section aria-labelledby="approach">
    <h2 id="approach">Approach</h2>
    <p>[COPY]</p>
  </section>
</Base>
