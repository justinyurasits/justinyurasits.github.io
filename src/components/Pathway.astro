---
// JYC-CAP-06: a pathway page. It opens with a named business problem, states the outcomes
// of an engagement, and ends with a next step that reaches the contact options on the
// same page. It never shows Justin's fees or service pricing.
import Base from '../layouts/Base.astro';
import ContactOptions from './ContactOptions.astro';
interface Props { title: string; services: string[] }
const { title, services } = Astro.props;
---
<Base title={title} description="[COPY]">
  <h1>{title}</h1>
  <section aria-labelledby="problem" data-slot="problem">
    <h2 id="problem" class="visually-hidden">The problem</h2>
    <p>[COPY]</p>
  </section>

  <section aria-labelledby="outcomes" data-slot="outcomes">
    <h2 id="outcomes">What an engagement delivers</h2>
    <p>[COPY]</p>
  </section>

  <section aria-labelledby="services">
    <h2 id="services">Engagements</h2>
    <ul>{services.map((s) => <li>{s}</li>)}</ul>
    <slot name="details" />
  </section>

  <section aria-labelledby="next-step" data-slot="next-step">
    <h2 id="next-step">Next step</h2>
    <p>[COPY]</p>
    <ContactOptions headingLevel={3} />
  </section>
</Base>
